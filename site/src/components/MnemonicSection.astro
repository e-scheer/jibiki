---
import type { Messages } from '../i18n/messages';

interface Props {
  t: Messages;
}

const { t } = Astro.props;
---

<section class="section mnemonic-section" id="community">
  <div class="container mnemonic-grid">
    <div class="mnemonic-copy">
      <span class="kicker">{t.mnemonic.kicker}</span>
      <h2>{t.mnemonic.title}</h2>
      <p class="section-copy">{t.mnemonic.body}</p>
      <p class="mnemonic-community">{t.mnemonic.community}</p>
    </div>

    <div class="mnemonic-showcase">
      <div class="glyph-banner">
        <strong lang="ja">{t.mnemonic.glyph}</strong>
        <div class="glyph-facts">
          <b lang="ja">{t.mnemonic.glyphReading}</b>
          <span>{t.mnemonic.glyphMeaning}</span>
        </div>
      </div>

      <article class="meaning-card">
        <div class="card-head">
          <span class="card-label">{t.mnemonic.meaningCard.label}</span>
          <span class="card-scope">{t.mnemonic.meaningCard.scope}</span>
        </div>
        <blockquote>« {t.mnemonic.meaningCard.quote} »</blockquote>
        <div class="meaning-parts" aria-hidden="true">
          {t.mnemonic.meaningCard.parts.map((part, index) => (
            <>
              {index > 0 && <i>+</i>}
              <span><b lang="ja">{part.glyph}</b><small>{part.label}</small></span>
            </>
          ))}
          <i>=</i>
          <span class="parts-result"><b lang="ja">{t.mnemonic.glyph}</b></span>
        </div>
      </article>

      <p class="reading-label">{t.mnemonic.readingLabel}</p>
      <div class="reading-cards">
        {t.mnemonic.readingCards.map((card) => (
          <article class="reading-card">
            <span class="card-label">{card.language}</span>
            <blockquote lang={card.locale}>« {card.quote} »</blockquote>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .mnemonic-section {
    overflow: hidden;
    border-bottom: var(--line);
    background: var(--klein);
    color: #fff;
  }

  .mnemonic-section::after {
    position: absolute;
    right: -4rem;
    bottom: -6rem;
    width: 17rem;
    height: 17rem;
    border: 4px solid #fff;
    border-radius: 42% 58% 48% 52%;
    content: '';
    opacity: 0.18;
    transform: rotate(18deg);
  }

  .mnemonic-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(32rem, 1.15fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 6rem);
  }

  .kicker {
    color: var(--ink);
  }

  h2 {
    max-width: 12ch;
  }

  .section-copy {
    color: #fff;
  }

  .mnemonic-community {
    max-width: 52ch;
    padding: 0.9rem 1rem;
    border: 2.5px solid #fff;
    border-radius: 12px;
    background: rgb(255 255 255 / 10%);
    font-size: 0.9rem;
    font-weight: 600;
  }

  .mnemonic-showcase {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 1rem;
  }

  .glyph-banner {
    display: flex;
    width: max-content;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1.2rem;
    border: 3px solid var(--ink);
    border-radius: 14px;
    background: var(--acid);
    box-shadow: 6px 6px 0 var(--ink);
    color: var(--ink);
    transform: rotate(-1.5deg);
  }

  .glyph-banner strong {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 3.4rem;
    font-weight: 900;
    line-height: 1;
  }

  .glyph-facts {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .glyph-facts b {
    font-size: 1rem;
    font-weight: 900;
  }

  .glyph-facts span {
    font-size: 0.74rem;
    font-weight: 700;
  }

  .meaning-card,
  .reading-card {
    padding: 1.2rem 1.3rem;
    border: 3px solid var(--ink);
    border-radius: 15px;
    background: var(--surface);
    box-shadow: 7px 7px 0 var(--ink);
    color: var(--ink);
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .card-label {
    padding: 0.35rem 0.6rem;
    border: 2px solid var(--ink);
    border-radius: 7px;
    background: var(--acid);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .card-scope {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--ink-2);
  }

  blockquote {
    margin: 1rem 0 0;
    font-size: clamp(1.05rem, 1.8vw, 1.35rem);
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  .meaning-parts {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-top: 1rem;
    border-top: 2px solid rgb(23 19 31 / 18%);
  }

  .meaning-parts span {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.4rem;
    padding: 0.4rem 0.55rem;
    border: 2px solid var(--ink);
    border-radius: 9px;
    background: var(--lime);
  }

  .meaning-parts span:nth-of-type(2) {
    background: var(--lavender);
  }

  .meaning-parts .parts-result {
    background: var(--magenta);
    box-shadow: 3px 3px 0 var(--ink);
  }

  .meaning-parts b {
    font-family: 'Zen Kaku Gothic New', sans-serif;
    font-size: 1.4rem;
    font-weight: 900;
    line-height: 1.15;
  }

  .meaning-parts small {
    font-size: 0.56rem;
    font-weight: 700;
  }

  .meaning-parts i {
    font-size: 1rem;
    font-style: normal;
    font-weight: 700;
  }

  .reading-label {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    font-weight: 700;
  }

  .reading-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .reading-card:first-child {
    background: var(--lavender);
    transform: rotate(-0.8deg);
  }

  .reading-card:last-child {
    transform: rotate(0.8deg);
  }

  .reading-card blockquote {
    font-size: 1rem;
  }

  @media (max-width: 959px) {
    .mnemonic-grid {
      grid-template-columns: 1fr;
    }

    .mnemonic-copy {
      max-width: 44rem;
    }

    .mnemonic-showcase {
      width: min(100%, 46rem);
      margin-inline: auto;
    }
  }

  @media (max-width: 599px) {
    .meaning-card,
    .reading-card {
      padding: 1rem;
      box-shadow: 5px 5px 0 var(--ink);
      transform: none;
    }

    .reading-cards {
      grid-template-columns: 1fr;
    }

    .glyph-banner {
      box-shadow: 4px 4px 0 var(--ink);
    }

    .meaning-parts {
      flex-wrap: wrap;
    }
  }
</style>
